<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <!-- Interior Room Box -->
  <rect width="800" height="600" fill="#e2e8f0"/>
  <!-- Back Wall -->
  <rect x="160" y="80" width="480" height="340" fill="#f8fafc" stroke="#cbd5e1" stroke-width="2"/>
  
  <!-- Left Wall -->
  <polygon points="0,0 160,80 160,420 0,600" fill="#f1f5f9"/>
  <!-- Right Wall -->
  <polygon points="800,0 640,80 640,420 800,600" fill="#f1f5f9"/>
  <!-- Floor with Epoxy Green Tint -->
  <polygon points="0,600 160,420 640,420 800,600" fill="#d1fae5"/>
  <line x1="160" y1="420" x2="640" y2="420" stroke="#059669" stroke-width="3"/>

  <!-- Ceiling Light -->
  <ellipse cx="400" cy="110" rx="60" ry="12" fill="#ffffff" stroke="#cbd5e1"/>
  <polygon points="340,110 460,110 520,380 280,380" fill="#fef08a" opacity="0.3"/>

  <!-- Storage Pallet Mockup on Floor -->
  <polygon points="260,490 540,490 580,530 220,530" fill="#b45309"/>
  <rect x="220" y="530" width="360" height="15" fill="#78350f"/>

  <!-- Cardboard Storage Boxes Stacked -->
  <rect x="260" y="380" width="120" height="110" fill="#d97706" stroke="#92400e" stroke-width="2"/>
  <rect x="390" y="360" width="130" height="130" fill="#b45309" stroke="#78350f" stroke-width="2"/>
  <rect x="290" y="280" width="100" height="100" fill="#f59e0b" stroke="#b45309" stroke-width="2"/>

  <!-- Bottom Details Bar -->
  <rect x="80" y="520" width="640" height="45" fill="#ffffff" stroke="#000000" stroke-width="2"/>
  <text x="105" y="548" font-family="'Inter', sans-serif" font-size="14" font-weight="800" fill="#000000">KHÔNG GIAN NỘI THẤT KHO · TRẦN CAO 2.8M</text>
  <text x="695" y="548" font-family="'SFMono-Regular', monospace" font-size="12" font-weight="700" fill="#059669" text-anchor="end">SÀN EPOXY KHỬ ẨM 100%</text>
</svg>