# ==============================================================================
# StorageHub Backend - Environment Variables Template
# Copy file này thành .env (ở cùng thư mục backend/) và điền thông tin tương ứng:
#   cp .env.example .env
# Lưu ý: File .env chứa secret, KHÔNG BAO GIỜ commit lên git.
# ==============================================================================

# --- Database MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=storagehub
DB_USER=root
DB_PASS=yourPass

# --- Server / Profile ---
SERVER_PORT=8080
# SPRING_PROFILES_ACTIVE=dev

# JWT signing key (AD-5) - Base64, tao moi bang: openssl rand -base64 48
JWT_SECRET=xxxxxxxxxxxx